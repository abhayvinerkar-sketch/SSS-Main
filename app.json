{
  "expo": {
    "name": "SSC Master",
    "slug": "ssc-master",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "androidNavigationBar": {
      "visible": "sticky-immersive",
      "barStyle": "dark-content",
      "backgroundColor": "#F7F8FC",
      "enforceContrast": false
    },
    "plugins": [
      [
        "expo-navigation-bar",
        {
          "visibility": "hidden",
          "behavior": "overlay-swipe",
          "position": "absolute"
        }
      ]
    ],
    "android": {
      "package": "com.sscmaster.app"
    }
  }
}
